{
  "family": "Depportfolio-service",
  "containerDefinitions": [
    {
      "name": "petclinic-container",
      "image": "will-be-replaced-by-pipeline",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512"
}
